    {
      "name": "Login - Yara Admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Read the JSON response returned by the login endpoint.\r",
              "const response = pm.response.json();\r",
              "\r",
              "// Print the token to the Postman Console so we can verify\r",
              "// that the script can actually read it from the response.\r",
              "console.log(\"LOGIN TOKEN:\", response.token);\r",
              "\r",
              "// Save the JWT token into the active Postman environment.\r",
              "pm.environment.set(\"token\", response.token);\r",
              "\r",
              "// Print the saved environment value so we can verify\r",
              "// that Postman stored it successfully.\r",
              "console.log(\"SAVED TOKEN:\", pm.environment.get(\"token\"));"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"email\": \"yara@gmail.com\",\r\n  \"password\": \"YaraPassword123!\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:5030/api/Auth/login",
          "protocol": "http",
